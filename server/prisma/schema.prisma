generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum CharacterGender {
  MALE
  FEMALE
  OTHER
  UNKNOWN

  @@map("character_gender")
}

enum CharacterRole {
  MAIN
  SUPPORTING
  MINOR

  @@map("character_role")
}

enum CharacterStatus {
  ALIVE
  DECEASED
  UNDEAD
  UNKNOWN

  @@map("character_status")
}

enum AnimationStyle {
  TWO_D
  CGI
  STOP_MOTION
  PUPPET
  LIVE_ACTION
  MIXED_MEDIA
  OTHER

  @@map("animation_style")
}

model Character {
  id                Int             @id @default(autoincrement())
  slug              String          @unique @db.VarChar(120)
  name              String          @db.VarChar(120)
  fullName          String?         @map("full_name") @db.VarChar(200)
  aliases           String[]        @default([])
  description       String?
  species           String?         @db.VarChar(80)
  gender            CharacterGender @default(UNKNOWN)
  age               Int?            @db.SmallInt
  occupation        String?         @db.VarChar(200)
  role              CharacterRole   @default(MINOR)
  status            CharacterStatus @default(ALIVE)
  animationStyle    AnimationStyle  @default(TWO_D) @map("animation_style")
  voiceActors       String[]        @default([]) @map("voice_actors")
  firstAppearanceId Int?            @map("first_appearance_id")
  firstAppearance   Episode?        @relation("CharacterFirstAppearance", fields: [firstAppearanceId], references: [id], onDelete: SetNull)
  colors            String[]        @default([])
  imageUrl          String          @map("image_url") @db.VarChar(500)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  songs             SongCharacter[]

  @@index([name])
  @@index([species])
  @@index([gender])
  @@index([role])
  @@index([status])
  @@index([animationStyle])
  @@index([firstAppearanceId])
  @@map("characters")
}

enum LocationType {
  TOWN
  RESIDENCE
  SCHOOL
  SCHOOL_FACILITY
  SHOP
  RESTAURANT
  BUSINESS
  PUBLIC_SERVICE
  LEISURE
  TRANSPORT
  NATURE
  OTHER_REALM
  OTHER

  @@map("location_type")
}

model Location {
  id                Int          @id @default(autoincrement())
  slug              String       @unique @db.VarChar(120)
  name              String       @db.VarChar(120)
  description       String?
  type              LocationType @default(OTHER)
  parentId          Int?         @map("parent_id")
  parent            Location?    @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Location[]   @relation("LocationHierarchy")
  firstAppearanceId Int?         @map("first_appearance_id")
  firstAppearance   Episode?     @relation("LocationFirstAppearance", fields: [firstAppearanceId], references: [id], onDelete: SetNull)
  imageUrl          String       @map("image_url") @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([type])
  @@index([parentId])
  @@index([firstAppearanceId])
  @@map("locations")
}

enum EpisodeSeries {
  AMAZING_WORLD
  WONDERFULLY_WEIRD_WORLD

  @@map("episode_series")
}

enum EpisodeType {
  EPISODE
  SPECIAL
  SHORT
  PILOT
  FILM

  @@map("episode_type")
}

enum EpisodeStatus {
  RELEASED
  UNRELEASED
  SCRAPPED

  @@map("episode_status")
}

model Episode {
  id                Int           @id @default(autoincrement())
  slug              String        @unique @db.VarChar(160)
  title             String        @db.VarChar(200)
  description       String?
  series            EpisodeSeries @default(AMAZING_WORLD)
  type              EpisodeType   @default(EPISODE)
  status            EpisodeStatus @default(RELEASED)
  season            Int?          @db.SmallInt
  episodeNumber     Int?          @map("episode_number") @db.SmallInt
  overallNumber     Int?          @unique @map("overall_number") @db.SmallInt
  productionCode    String?       @map("production_code") @db.VarChar(20)
  usAirDate         DateTime?     @map("us_air_date") @db.Date
  ukAirDate         DateTime?     @map("uk_air_date") @db.Date
  writers           String[]      @default([])
  storyboardArtists String[]      @default([]) @map("storyboard_artists")
  imageUrl          String        @map("image_url") @db.VarChar(500)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  songs             Song[]
  debutCharacters   Character[]   @relation("CharacterFirstAppearance")
  debutLocations    Location[]    @relation("LocationFirstAppearance")
  debutMedia        Media[]       @relation("MediaFirstAppearance")

  @@unique([series, season, episodeNumber])
  @@index([title])
  @@index([type])
  @@index([status])
  @@index([season])
  @@index([usAirDate])
  @@map("episodes")
}

enum SeasonStatus {
  COMPLETED
  AIRING
  UPCOMING

  @@map("season_status")
}

model Season {
  id                 Int           @id @default(autoincrement())
  slug               String        @unique @db.VarChar(40)
  number             Int           @unique @db.SmallInt
  title              String        @db.VarChar(120)
  description        String?
  series             EpisodeSeries @default(AMAZING_WORLD)
  seriesSeasonNumber Int           @map("series_season_number") @db.SmallInt
  status             SeasonStatus  @default(UPCOMING)
  episodeCount       Int?          @map("episode_count") @db.SmallInt
  networks           String[]      @default([])
  usPremiereDate     DateTime?     @map("us_premiere_date") @db.Date
  usFinaleDate       DateTime?     @map("us_finale_date") @db.Date
  ukPremiereDate     DateTime?     @map("uk_premiere_date") @db.Date
  ukFinaleDate       DateTime?     @map("uk_finale_date") @db.Date
  imageUrl           String        @map("image_url") @db.VarChar(500)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([series, seriesSeasonNumber])
  @@index([status])
  @@map("seasons")
}

enum SongType {
  EPISODE
  THEME
  WEB

  @@map("song_type")
}

model Song {
  id              Int             @id @default(autoincrement())
  slug            String          @unique @db.VarChar(160)
  title           String          @db.VarChar(200)
  description     String?
  type            SongType        @default(EPISODE)
  episodeId       Int?            @map("episode_id")
  episode         Episode?        @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  characters      SongCharacter[]
  vocalists       String[]        @default([])
  genres          String[]        @default([])
  durationSeconds Int?            @map("duration_seconds") @db.SmallInt
  musicalKey      String?         @map("musical_key") @db.VarChar(120)
  imageUrl        String?         @map("image_url") @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([title])
  @@index([type])
  @@index([episodeId])
  @@map("songs")
}

model SongCharacter {
  songId      Int       @map("song_id")
  characterId Int       @map("character_id")
  song        Song      @relation(fields: [songId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([songId, characterId])
  @@index([characterId])
  @@map("song_characters")
}

enum GamePlatform {
  WEB
  MOBILE
  ROBLOX
  VOICE_ASSISTANT

  @@map("game_platform")
}

enum GameStatus {
  AVAILABLE
  DISCONTINUED
  UNKNOWN

  @@map("game_status")
}

model Game {
  id          Int            @id @default(autoincrement())
  slug        String         @unique @db.VarChar(160)
  title       String         @db.VarChar(200)
  description String?
  platforms   GamePlatform[] @default([])
  status      GameStatus     @default(UNKNOWN)
  releaseDate DateTime?      @map("release_date") @db.Date
  releaseYear Int?           @map("release_year") @db.SmallInt
  developers  String[]       @default([])
  imageUrl    String         @map("image_url") @db.VarChar(500)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([title])
  @@index([status])
  @@index([releaseYear])
  @@map("games")
}

enum MediaType {
  TV_SHOW
  MOVIE
  COMIC
  BOOK
  APP
  VIDEO_GAME
  VIDEO

  @@map("media_type")
}

model Media {
  id                Int       @id @default(autoincrement())
  slug              String    @unique @db.VarChar(160)
  title             String    @db.VarChar(200)
  description       String?
  type              MediaType
  parodyOf          String?   @map("parody_of") @db.VarChar(200)
  firstAppearanceId Int?      @map("first_appearance_id")
  firstAppearance   Episode?  @relation("MediaFirstAppearance", fields: [firstAppearanceId], references: [id], onDelete: SetNull)
  imageUrl          String    @map("image_url") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([title])
  @@index([type])
  @@index([firstAppearanceId])
  @@map("media")
}
