generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum CharacterGender {
  MALE
  FEMALE
  OTHER
  UNKNOWN

  @@map("character_gender")
}

enum CharacterRole {
  MAIN
  SUPPORTING
  MINOR

  @@map("character_role")
}

enum CharacterStatus {
  ALIVE
  DECEASED
  UNDEAD
  UNKNOWN

  @@map("character_status")
}

enum AnimationStyle {
  TWO_D
  CGI
  STOP_MOTION
  PUPPET
  LIVE_ACTION
  MIXED_MEDIA
  OTHER

  @@map("animation_style")
}

model Character {
  id              Int             @id @default(autoincrement())
  slug            String          @unique @db.VarChar(120)
  name            String          @db.VarChar(120)
  fullName        String?         @map("full_name") @db.VarChar(200)
  aliases         String[]        @default([])
  description     String?
  species         String?         @db.VarChar(80)
  gender          CharacterGender @default(UNKNOWN)
  age             Int?            @db.SmallInt
  occupation      String?         @db.VarChar(200)
  role            CharacterRole   @default(MINOR)
  status          CharacterStatus @default(ALIVE)
  animationStyle  AnimationStyle  @default(TWO_D) @map("animation_style")
  voiceActors     String[]        @default([]) @map("voice_actors")
  firstAppearance String?         @map("first_appearance") @db.VarChar(200)
  colors          String[]        @default([])
  imageUrl        String          @map("image_url") @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([species])
  @@index([gender])
  @@index([role])
  @@index([status])
  @@index([animationStyle])
  @@map("characters")
}

enum LocationType {
  TOWN
  RESIDENCE
  SCHOOL
  SCHOOL_FACILITY
  SHOP
  RESTAURANT
  BUSINESS
  PUBLIC_SERVICE
  LEISURE
  TRANSPORT
  NATURE
  OTHER_REALM
  OTHER

  @@map("location_type")
}

model Location {
  id              Int          @id @default(autoincrement())
  slug            String       @unique @db.VarChar(120)
  name            String       @db.VarChar(120)
  description     String?
  type            LocationType @default(OTHER)
  parentId        Int?         @map("parent_id")
  parent          Location?    @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Location[]   @relation("LocationHierarchy")
  firstAppearance String?      @map("first_appearance") @db.VarChar(200)
  imageUrl        String       @map("image_url") @db.VarChar(500)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([type])
  @@index([parentId])
  @@map("locations")
}

enum EpisodeSeries {
  AMAZING_WORLD
  WONDERFULLY_WEIRD_WORLD

  @@map("episode_series")
}

enum EpisodeType {
  EPISODE
  SPECIAL
  SHORT
  PILOT
  FILM

  @@map("episode_type")
}

enum EpisodeStatus {
  RELEASED
  UNRELEASED
  SCRAPPED

  @@map("episode_status")
}

model Episode {
  id                Int           @id @default(autoincrement())
  slug              String        @unique @db.VarChar(160)
  title             String        @db.VarChar(200)
  description       String?
  series            EpisodeSeries @default(AMAZING_WORLD)
  type              EpisodeType   @default(EPISODE)
  status            EpisodeStatus @default(RELEASED)
  season            Int?          @db.SmallInt
  episodeNumber     Int?          @map("episode_number") @db.SmallInt
  overallNumber     Int?          @unique @map("overall_number") @db.SmallInt
  productionCode    String?       @map("production_code") @db.VarChar(20)
  usAirDate         DateTime?     @map("us_air_date") @db.Date
  ukAirDate         DateTime?     @map("uk_air_date") @db.Date
  writers           String[]      @default([])
  storyboardArtists String[]      @default([]) @map("storyboard_artists")
  imageUrl          String        @map("image_url") @db.VarChar(500)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([series, season, episodeNumber])
  @@index([title])
  @@index([type])
  @@index([status])
  @@index([season])
  @@index([usAirDate])
  @@map("episodes")
}
